{
  "name": "tanglish-kit",
  "version": "0.1.0",
  "description": "Tamil & Tanglish NLP toolkit: phonetic transliteration, romanization, code-mixed language detection and Tamil letter analysis. Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tanglish": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "build:site": "node scripts/build-site.mjs",
    "dev": "node scripts/build-site.mjs --serve",
    "train": "tsx scripts/train-langid.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tamil",
    "tanglish",
    "transliteration",
    "romanization",
    "nlp",
    "code-mixing",
    "language-detection",
    "indic",
    "llm"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
